# ==== Database (Neon) ====
# Ambil connection string dari dashboard Neon > Connect.
# Gunakan host yang mengandung "-pooler" agar aman untuk Vercel (serverless).
# Contoh: postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ==== Sesi login ====
# String acak panjang. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
